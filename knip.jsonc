{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "ignore": ["scripts/**", "tools/**"],
  "ignoreDependencies": [
    "@tanstack/eslint-plugin-query",
    "@testing-library/user-event",
    "eslint-plugin-github",
    "eslint-plugin-jsdoc",
    "eslint-plugin-sonarjs",
    "eslint-plugin-storybook",
    "eslint-plugin-tsdoc",
    "oxlint-plugin-react-doctor",
  ],
  "oxlint": {
    "config": ["oxlint.config.ts", "oxfmt.config.ts"],
  },
  "storybook": {
    "entry": [
      ".storybook/preview.tsx",
      ".storybook/sb-provider.tsx",
      "src/**/*.stories.@(js|jsx|ts|tsx)",
    ],
  },
  "tailwind": {
    "entry": ["src/lib/styles/globals.css"],
  },
  "vitest": {
    "entry": ["**/*.{test,spec}.{ts,tsx}", "vitest.global-setup.ts"],
  },
}
